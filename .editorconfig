root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[src/MarketplaceHub.Infrastructure/Persistence/Migrations/*.cs]
generated_code = true
charset = unset
end_of_line = unset
csharp_style_namespace_declarations = unset
