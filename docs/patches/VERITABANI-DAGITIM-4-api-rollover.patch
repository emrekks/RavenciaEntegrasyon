diff --git a/deploy/scripts/api-rollover.sh b/deploy/scripts/api-rollover.sh
new file mode 100644
index 000000000..632e52b3f
--- /dev/null
+++ b/deploy/scripts/api-rollover.sh
@@ -0,0 +1,82 @@
+#!/usr/bin/env bash
+# VERITABANI-DAGITIM-4: a full deploy replaces the api without a pause (docs/RUNBOOK-GERI-ALMA.md section 10). Sourced by
+# fast-deploy.sh after the migration ran; uses its `compose` and `sudo_cmd` arrays. The new api container starts next to
+# the running one (Compose scale +1, the running one is not recreated); once Docker reports it healthy, Caddy (dynamic
+# upstreams from Docker DNS, refreshed every second) already sends it requests, and the old one is stopped with the same
+# 45 s grace as compose.yaml's stop_grace_period, so requests under way finish. A new container that never gets healthy
+# is removed and the old one keeps serving. Containers are found by their Compose labels, never by the -1 name.
+# Settings (the tests set them to zero): API_ROLLOVER_HEALTH_ATTEMPTS (60), API_ROLLOVER_HEALTH_INTERVAL (2 s),
+# API_ROLLOVER_SETTLE (5 s: Caddy's DNS refresh sees the new copy before the old one goes), API_ROLLOVER_STOP_TIME (45 s).
+
+api_container_ids() {
+  "${sudo_cmd[@]}" docker ps -q \
+    --filter label=com.docker.compose.project=marketplacehub \
+    --filter label=com.docker.compose.service=api
+}
+
+# The api containers now running that were not in the given list (one id per line).
+api_new_container_ids() {
+  local known="$1" current id
+  current="$(api_container_ids)"
+  while IFS= read -r id; do
+    [[ -n "$id" ]] || continue
+    grep -qxF -- "$id" <<<"$known" || printf '%s\n' "$id"
+  done <<<"$current"
+}
+
+api_remove_containers() {
+  local id
+  for id in "$@"; do
+    "${sudo_cmd[@]}" docker rm -f "$id" >/dev/null || echo "Could not remove api container $id." >&2
+  done
+}
+
+# 0: the new api serves and the old ones are gone. 1: the new one did not start or never got healthy; it was removed and
+# the old one still serves (nothing else was touched).
+api_rollover() {
+  local attempts="${API_ROLLOVER_HEALTH_ATTEMPTS:-60}" interval="${API_ROLLOVER_HEALTH_INTERVAL:-2}"
+  local settle="${API_ROLLOVER_SETTLE:-5}" stop_time="${API_ROLLOVER_STOP_TIME:-45}"
+  local old_ids old_count new_id state attempt healthy=false
+  local -a new_ids=()
+  old_ids="$(api_container_ids)"
+  if [[ -z "$old_ids" ]]; then
+    echo "No api container is running; starting it the ordinary way."
+    "${compose[@]}" up -d --no-build --no-deps api
+    return
+  fi
+  old_count="$(grep -c . <<<"$old_ids")"
+  if ! "${compose[@]}" up -d --no-build --no-deps --no-recreate --scale "api=$((old_count + 1))" api; then
+    echo "The new api container could not be started; the running one keeps serving." >&2
+    mapfile -t new_ids < <(api_new_container_ids "$old_ids")
+    api_remove_containers "${new_ids[@]}"
+    return 1
+  fi
+  mapfile -t new_ids < <(api_new_container_ids "$old_ids")
+  if (( ${#new_ids[@]} != 1 )); then
+    echo "Expected one new api container, found ${#new_ids[@]}; the running one keeps serving." >&2
+    api_remove_containers "${new_ids[@]}"
+    return 1
+  fi
+  new_id="${new_ids[0]}"
+  for (( attempt = 1; attempt <= attempts; attempt++ )); do
+    state="$("${sudo_cmd[@]}" docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$new_id" 2>/dev/null || echo missing)"
+    case "$state" in
+      "running healthy") healthy=true; break ;;
+      "running unhealthy" | exited* | dead* | missing) break ;;
+    esac
+    sleep "$interval"
+  done
+  if [[ "$healthy" != true ]]; then
+    echo "The new api container $new_id did not become healthy ($state); it was removed and the running one keeps serving." >&2
+    "${sudo_cmd[@]}" docker logs --tail 40 "$new_id" >&2 || true
+    api_remove_containers "$new_id"
+    return 1
+  fi
+  sleep "$settle"
+  # shellcheck disable=SC2086 # one container id per word
+  "${sudo_cmd[@]}" docker stop --time "$stop_time" $old_ids >/dev/null \
+    || { echo "The previous api container(s) could not be stopped; both copies are running." >&2; return 1; }
+  # shellcheck disable=SC2086 # one container id per word
+  "${sudo_cmd[@]}" docker rm $old_ids >/dev/null || echo "The stopped api container(s) could not be removed." >&2
+  echo "The api now runs as $new_id; the previous container stopped after its requests finished."
+}
