diff --git a/deploy/backup/restore-drill.sh b/deploy/backup/restore-drill.sh
index 4814cf076..dcb774833 100644
--- a/deploy/backup/restore-drill.sh
+++ b/deploy/backup/restore-drill.sh
@@ -81,7 +81,22 @@ sudo docker volume inspect "$backup_volume" >/dev/null
 
 umask 077
 cp -- "$secrets_root/postgres_password.txt" "$password_file"
-cp -- "$secrets_root/app_db_connection.txt" "$connection_file"
+# The isolated database knows only the marketplacehub superuser (password postgres_password.txt); production's
+# app_db_connection.txt logs in as marketplacehub_app (docs/RUNBOOK-GERI-ALMA.md section 7). Same host, database and
+# options, superuser login.
+connection_source="$(<"$secrets_root/app_db_connection.txt")"
+postgres_password="$(<"$password_file")"
+connection=""
+IFS=';' read -r -a connection_parts <<<"$connection_source"
+for part in "${connection_parts[@]}"; do
+  case "$part" in
+    Username=*) part="Username=marketplacehub" ;;
+    Password=*) part="Password=$postgres_password" ;;
+  esac
+  connection+="${connection:+;}$part"
+done
+printf '%s' "$connection" > "$connection_file"
+unset connection_source postgres_password connection connection_parts
 # The disposable internal server may advertise GSS encryption although the chiseled app image intentionally
 # does not carry Kerberos libraries. Authentication remains SCRAM; only optional GSS transport negotiation is disabled.
 printf ';GSS Encryption Mode=Disable' >> "$connection_file"
