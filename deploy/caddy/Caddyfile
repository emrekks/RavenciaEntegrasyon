{
  admin off
  auto_https disable_redirects
}

{$MARKETPLACEHUB_SITE_ADDRESS:https://localhost} {
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.dsmcdn.com; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
  }

  @webhook path /api/v1/hooks/*
  request_body @webhook {
		max_size 10MB
  }
  log_skip @webhook

  # SignalR negotiation and WebSocket traffic must reach the API, not the SPA fallback.
  @backend path /api/* /health/* /hubs/*
  handle @backend {
    reverse_proxy api:8080 {
      @unauthenticated status 401
      handle_response @unauthenticated {
        header Clear-Site-Data "\"cache\""
        copy_response
      }
    }
  }
  handle {
    root * /srv
    @static_assets path /assets/*
    header @static_assets Cache-Control "public, max-age=31536000, immutable"
    @application_shell not path /assets/*
    header @application_shell Cache-Control "no-store, no-cache, must-revalidate"
    try_files {path} /index.html
    file_server
  }
  log {
    output stdout
    format json
  }
}
