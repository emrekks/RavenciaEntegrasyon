{
	admin off
}

{$MARKETPLACEHUB_SITE_ADDRESS} {
	# API and SignalR responses are not compressed: compressing secrets (CSRF
	# token, session-bound data) next to attacker-influenced input in the same
	# response is the BREACH class. Static assets and the SPA shell still are.
	@compressible not path /api/* /hubs/*
	encode @compressible zstd gzip
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.dsmcdn.com https://productimages.hepsiburada.net https://www.hepsijet.com https://img.pzrmcdn.com; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
	}

	@webhook path /api/v1/hooks/*
	request_body @webhook {
		max_size 10MB
	}
	log_skip @webhook

	# /health/live stays public (process liveness only, for external uptime
	# monitors and the Deploy workflow). Readiness and queue state answer only to
	# private sources: the host itself (deploy scripts and the health watch enter
	# through loopback, which reaches the container from a Docker bridge address)
	# and the compose networks. Everyone else gets a plain 404.
	@health_private_only {
		path /health/*
		not path /health/live
		not remote_ip private_ranges
	}
	handle @health_private_only {
		respond 404
	}

	# Only a 401 from the authentication endpoints clears the browser cache; a 401
	# elsewhere (expired session on a data call) must not wipe the whole site cache.
	handle /api/v1/auth/* {
		reverse_proxy api:8080 {
			@unauthenticated status 401
			handle_response @unauthenticated {
				header Clear-Site-Data "\"cache\""
				copy_response
			}
		}
	}

	# SignalR negotiation and WebSocket traffic must reach the API, not the SPA fallback.
	@backend path /api/* /health/* /hubs/*
	handle @backend {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		@static_assets path /assets/*
		header @static_assets Cache-Control "public, max-age=31536000, immutable"
		# Logos, brand artwork and fonts keep their names across releases: cached for a day and
		# refreshed in the background, instead of being downloaded again on every page.
		@public_media path /platforms/* /pack/* /fonts/*
		header @public_media Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		@application_shell not path /assets/* /platforms/* /pack/* /fonts/*
		header @application_shell Cache-Control "no-store, no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
	log {
		output stdout
		format json
	}
}
