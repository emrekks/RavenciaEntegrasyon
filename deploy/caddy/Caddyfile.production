{
	admin off
	servers {
		# No HTTP/3 early data (0-RTT). The remote_ip matcher of @health_private_only is evaluated for every request
		# and answers a request still inside the TLS handshake with 425 Too Early (live: ~300 a day, all GETs on
		# resumed h3 connections); the browser then sends it again. Without 0-RTT a resumed connection waits one
		# round trip instead, and no request can be replayed from early data.
		0rtt off
	}
}

# Container healthcheck only (compose: wget http://127.0.0.1:8081/healthz): loopback inside the
# container, never published, not logged.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
	respond 404
}

{$MARKETPLACEHUB_SITE_ADDRESS} {
	# API and SignalR responses are not compressed: compressing secrets (CSRF
	# token, session-bound data) next to attacker-influenced input in the same
	# response is the BREACH class. Static assets and the SPA shell still are.
	@compressible not path /api/* /hubs/*
	encode @compressible zstd gzip
	# Exception (speed plan P4, 9 Nov 2026; widened 10 Nov 2026): large read-only lists, compressed only for the panel's
	# own fetches. BREACH needs a secret and attacker-chosen input in the same compressed body, and the attacker must make
	# the victim's browser send many such requests while watching their sizes. Here:
	#   - the bodies carry no secret. Reviewed body by body:
	#     - GET /products, /products/{id}, the category attribute requirements, /catalog/attributes and the marketplace
	#       reference lists (categories, attributes, values, value mappings): catalog data, public marketplace data and
	#       the tenant's own mappings;
	#     - /reports/sales, /order-profitability, /stock, /payouts, /payouts/lines, /ad-report, /price-assumptions:
	#       figures, order numbers, store names, payout record ids; their pictures are session-only /files/ links or
	#       marketplace CDN addresses (CatalogMediaDisplay), no invoice or public-document link;
	#     - /jobs/page and /jobs/counts: job ids, types, states, counts and the panel's own error summaries;
	#     - /dashboard/performance: figures only;
	#     - /connections/{id}/commission-tariffs/{id}/rows: products, commission bands and session-only pictures;
	#     paging cursors are DataProtection-encrypted and search terms are not echoed; no CSRF token, session value or
	#     bearer link;
	#   - Sec-Fetch-Site same-origin: a request another site starts (link, image, form, top-level navigation, which
	#     carries the SameSite=Lax cookie) says cross-site or same-site and stays uncompressed, so no attacker can
	#     drive the requests BREACH needs;
	#   - GET only, exact paths: /products/summary, /products/{id}/..., every other /api/* route, /hubs/*, /auth/* and
	#     anything that returns tokens or links (orders, invoices and the invoice workspace carry bearer invoice links,
	#     /public/* carries access tokens) stay uncompressed.
	@compressible_catalog {
		method GET
		header Sec-Fetch-Site same-origin
		path_regexp ^/api/v1/(products(/[0-9a-fA-F-]{36})?|catalog/(attributes|categories/[0-9a-fA-F-]{36}/attribute-requirements)|mappings/attribute-values/batch|reference-data/categories(/[A-Za-z0-9._-]{1,128}/(attribute-values|attributes(/[A-Za-z0-9._-]{1,256}/values)?))?|reports/(sales|order-profitability|stock|payouts(/lines)?|ad-report|price-assumptions)|jobs/(page|counts)|dashboard/performance|connections/[0-9a-fA-F-]{36}/commission-tariffs/[0-9a-fA-F-]{36}/rows)$
	}
	encode @compressible_catalog zstd gzip
	header {
		# Deletions are deferred, so they also strip what reverse_proxy adds to API responses.
		-Server
		-Via
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.dsmcdn.com https://productimages.hepsiburada.net https://www.hepsijet.com https://img.pzrmcdn.com; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"
	}

	# Cross-Origin-Resource-Policy: same-origin everywhere except the product pictures sent to the marketplaces
	# (/api/v1/public/product-media/{id}/content, ProductPublicationComposer). A marketplace seller panel shows them from
	# its own site until it has copied them (live 2026-11-06: the new Zümrüt card of MZ028IH showed two broken pictures
	# in Trendyol's panel, Chrome refused the same-origin images there). Two matchers, not an override: a deferred
	# header block would apply last and win.
	@marketplace_pictures path /api/v1/public/product-media/*
	header @marketplace_pictures Cross-Origin-Resource-Policy "cross-origin"
	@not_marketplace_pictures not path /api/v1/public/product-media/*
	header @not_marketplace_pictures Cross-Origin-Resource-Policy "same-origin"

	@webhook path /api/v1/hooks/*
	request_body @webhook {
		max_size 10MB
	}
	log_skip @webhook
	# Public invoice links carry their access token in the path: they are not written to the access log.
	@public_documents path /api/v1/public/*
	log_skip @public_documents

	# /health/live stays public (process liveness only, for external uptime
	# monitors and the Deploy workflow). Readiness and queue state answer only to
	# private sources: the host itself (deploy scripts and the health watch enter
	# through loopback, which reaches the container from a Docker bridge address)
	# and the compose networks. Everyone else gets a plain 404.
	@health_private_only {
		path /health/* /internal/*
		not path /health/live
		not remote_ip private_ranges
	}
	handle @health_private_only {
		respond 404
	}

	# RFC 9116 contact for security reports. A single-path handle sorts before the named-matcher handles below.
	# Expires must stay in the future: the CI ops job fails 30 days before it, renew it then (one year ahead).
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		respond <<SECURITYTXT
			Contact: mailto:destek@ravencia.com
			Expires: 2027-11-03T00:00:00.000Z
			Preferred-Languages: tr, en
			Canonical: {$MARKETPLACEHUB_SITE_ADDRESS}/.well-known/security.txt
			
			SECURITYTXT 200
	}

	# The panel is a private application: nothing here is for search engines.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		respond <<ROBOTSTXT
			User-agent: *
			Disallow: /

			ROBOTSTXT 200
	}

	# Scanner paths (dotfiles, PHP, WordPress, CGI, vendor folders, API explorers, metrics) get a plain 404
	# instead of the SPA shell, so probes are visible as 404s to the ban rules. /.well-known stays open for ACME.
	@probe {
		path /.* *.php /wp-* /wp/* /cgi-bin/* /vendor/* /phpmyadmin* /xmlrpc* /actuator* /server-status* /swagger* /openapi* /metrics*
		not path /.well-known/*
	}
	handle @probe {
		respond 404
	}

	# Only a 401 from the authentication endpoints clears the browser cache; a 401
	# elsewhere (expired session on a data call) must not wipe the whole site cache.
	handle /api/v1/auth/* {
		reverse_proxy api:8080 {
			@unauthenticated status 401
			handle_response @unauthenticated {
				header Clear-Site-Data "\"cache\""
				copy_response
			}
		}
	}

	# SignalR negotiation and WebSocket traffic must reach the API, not the SPA fallback.
	# /internal/* is the host's alert settings sync (private sources only, see above, plus a host token).
	@backend path /api/* /health/* /hubs/* /internal/*
	handle @backend {
		reverse_proxy api:8080
	}
	handle {
		root * /srv
		@static_assets path /assets/*
		header @static_assets Cache-Control "public, max-age=31536000, immutable"
		# Logos, brand artwork and fonts keep their names across releases: cached for a day and
		# refreshed in the background, instead of being downloaded again on every page.
		@public_media path /platforms/* /pack/* /fonts/*
		header @public_media Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
		@application_shell not path /assets/* /platforms/* /pack/* /fonts/*
		header @application_shell Cache-Control "no-store, no-cache, must-revalidate"
		try_files {path} /index.html
		# The build writes a brotli (.br) and a zstd (.zst) copy next to each script and stylesheet
		# (src/MarketplaceHub.Web/scripts/precompress-assets.mjs); they are sent as they are, at the highest
		# compression levels, without compressing on every request. A client that takes neither gets the file through
		# `encode` above.
		file_server @static_assets {
			precompressed br zstd
		}
		file_server
	}
	# The access log keeps no request secrets: the CSRF token and idempotency keys are dropped and query
	# strings (search terms, cursors) are cut. Caddy already leaves cookies and Authorization out.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Csrf-Token delete
				request>headers>Idempotency-Key delete
				request>headers>X-Idempotency-Key delete
				request>uri regexp \?.*$ ?redacted
			}
		}
	}
}
