# syntax=docker/dockerfile:1.7
FROM node:26.13.0-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216 AS web
WORKDIR /web
COPY src/MarketplaceHub.Web/package.json src/MarketplaceHub.Web/package-lock.json ./
RUN npm install --global npm@11.12.1 \
 && npm ci --ignore-scripts
COPY src/MarketplaceHub.Web/ ./
# The bundle only: typecheck, lint, tests and the bundle budget run in Validate's frontend job, which gates every
# deploy, so neither CI's image-edge job nor the server repeats them. build:assets also writes the .br/.zst copies
# Caddy serves from /assets (scripts/precompress-assets.mjs).
RUN npm run build:assets

FROM caddy:2.11.9@sha256:0c2243efcf437ab7f7a978f1027fcf0d4f9be8a75df27b1b3fbc5dbe0ffa8cf0
# The base image still ships brotli-libs 1.2.0 (CVE-2026-111497, CRITICAL, fixed in 1.2.1-r0; Trivy in
# Validate). Drop this line once a caddy digest carries the fixed package.
RUN apk upgrade --no-cache brotli-libs
COPY deploy/caddy/Caddyfile.production /etc/caddy/Caddyfile
# Fail the image build (CI and server) on a Caddyfile that does not parse.
RUN MARKETPLACEHUB_SITE_ADDRESS=https://build-check.invalid caddy adapt --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null
COPY --from=web /web/dist /srv
