[Unit]
Description=Refresh the age-encrypted secrets escrow that rides along in every off-site copy (deploy/backup/secrets-escrow.sh)
Requires=docker.service
After=docker.service
OnFailure=ravencia-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/ravencia
ExecStart=/usr/bin/bash /usr/local/lib/ravencia/deploy/backup/secrets-escrow.sh
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Root drives Docker through its socket and writes only into the backup volume; deploy/secrets is only read.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
PrivateTmp=yes
