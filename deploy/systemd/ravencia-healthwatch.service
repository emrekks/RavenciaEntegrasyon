[Unit]
Description=Check Ravencia readiness, queues and Worker health; restart an unhealthy API; alert
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/ravencia
ExecStart=/usr/local/lib/ravencia/deploy/scripts/healthwatch.sh
# Failure counters and alert throttling survive between runs here.
StateDirectory=ravencia-healthwatch
TimeoutStartSec=4min
# Runs as root (no sudo, so NoNewPrivileges holds) and drives Docker through its socket.
# The repository stays readable; the host system and home directories are read-only here.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
PrivateTmp=yes
