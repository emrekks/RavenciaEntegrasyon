[Unit]
Description=Publish the newest base backup and its WAL, age-encrypted, for the off-site copy (deploy/backup/wal-archive.sh ship)
Requires=docker.service
After=docker.service
OnFailure=ravencia-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/ravencia
ExecStart=/usr/bin/bash /usr/local/lib/ravencia/deploy/backup/wal-archive.sh ship
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Root reads the WAL archive volume and writes the encrypted copy into the backup volume.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
PrivateTmp=yes
