[Unit]
Description=Send a Ravencia operator alert for the failed unit %i
# Used as OnFailure=ravencia-alert@%n.service by the backup and restore-drill units.

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/RavenciaEntegrasyon
ExecStart=/home/ubuntu/RavenciaEntegrasyon/deploy/scripts/send-alert.sh "%i failed; see: journalctl -u %i -n 100"
TimeoutStartSec=2min
# Runs as root (no sudo, so NoNewPrivileges holds) and drives Docker through its socket.
# The repository stays readable; the host system and home directories are read-only here.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
PrivateTmp=yes
