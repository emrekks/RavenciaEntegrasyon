[Unit]
Description=Physical base backup into the local WAL archive (deploy/backup/wal-archive.sh basebackup)
Requires=docker.service
After=docker.service
OnFailure=ravencia-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/usr/local/lib/ravencia
ExecStart=/usr/bin/bash /usr/local/lib/ravencia/deploy/backup/wal-archive.sh basebackup
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Root drives Docker through its socket; pg_basebackup runs inside the PostgreSQL container into its archive volume.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
PrivateTmp=yes
