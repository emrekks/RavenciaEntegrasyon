[Unit]
Description=Run the Ravencia health watch every five minutes

[Timer]
# Every 5 minutes, all day: the host runs around the clock (no nightly stop since
# 27 October 2026). healthwatch.sh skips the first 10 minutes after a boot.
OnCalendar=*-*-* *:00/5:00
AccuracySec=30s
Unit=ravencia-healthwatch.service

[Install]
WantedBy=timers.target
