[Unit]
Description=Refresh the Ravencia secrets escrow daily

[Timer]
# Before the 08:59 UTC backup set, so the escrow is in that set's off-site copy (09:30 UTC). install-backup-timer.sh installs
# this timer only once the owner created deploy/secrets/secrets_escrow.enabled (docs/RUNBOOK-GERI-ALMA.md section 5).
OnCalendar=*-*-* 08:40:00 UTC
Persistent=true
RandomizedDelaySec=5m
Unit=ravencia-secrets-escrow.service

[Install]
WantedBy=timers.target
