[Unit]
Description=Refresh CrowdSec allowlists (GitHub Actions ranges, private ranges)
Requires=crowdsec.service
After=crowdsec.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
# Root-owned copy installed by deploy/scripts/install-crowdsec.sh.
ExecStart=/usr/local/sbin/ravencia-crowdsec-allowlist
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
