[Unit]
Description=Refresh CrowdSec allowlists (GitHub Actions ranges, private ranges)
Requires=crowdsec.service
After=crowdsec.service network-online.target
Wants=network-online.target
OnFailure=ravencia-alert@%n.service

[Service]
Type=oneshot
User=root
# Root-owned copy refreshed by every deploy (install-backup-timer.sh).
ExecStart=/usr/local/lib/ravencia/deploy/scripts/crowdsec-allowlist-refresh.sh
TimeoutStartSec=30min
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
