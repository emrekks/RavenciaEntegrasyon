{
  "name": "marketplacehub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:assets",
    "build:assets": "vite build && node scripts/precompress-assets.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:security": "vitest run src/shared/security/sanitizeHtml.test.ts",
    "lint": "eslint . --max-warnings=0",
    "test:visual": "node tests/visual/run.mjs",
    "test:label-print": "vite build --logLevel warn && node tests/visual/label-print.mjs",
    "check:cascade": "node tests/visual/cascade-check.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.11",
    "@tanstack/react-query": "5.107.1",
    "age-encryption": "0.3.1",
    "dompurify": "^3.4.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  }
}
