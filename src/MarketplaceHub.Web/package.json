{
  "name": "marketplacehub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1",
    "npm": "11.12.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:security": "vitest run src/shared/security/sanitizeHtml.test.ts",
    "lint": "eslint . --max-warnings=0",
    "test:visual": "node tests/visual/run.mjs",
    "check:cascade": "node tests/visual/cascade-check.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "10.0.0",
    "@tanstack/react-query": "5.101.4",
    "dompurify": "^3.4.16",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.1.5",
    "vitest": "^5.0.0"
  }
}
