# Copy to a secret-managed environment; never commit the populated file.
MARKETPLACEHUB_ENVIRONMENT=PILOT_LOCAL
POSTGRES_DB=marketplacehub
POSTGRES_USER=marketplacehub
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
ConnectionStrings__AppDb_FILE=/run/secrets/app_db_connection
Bootstrap__OwnerPassword_FILE=/run/secrets/bootstrap_owner_password
Bootstrap__Enabled=false
Bootstrap__TenantCode=ravencia
Bootstrap__TenantDisplayName=Ravencia
Bootstrap__OwnerEmail=owner@example.invalid
Bootstrap__OwnerDisplayName=Ravencia Admin
Security__TotpEnabled=false
Security__CredentialKey_FILE=/run/secrets/credential_key
DataProtection__CertificatePath=/run/secrets/dp_certificate
DataProtection__CertificatePassword_FILE=/run/secrets/dp_certificate_password
FeatureFlags__ExternalWrites=false
Storage__MaxUploadBytes=10485760
