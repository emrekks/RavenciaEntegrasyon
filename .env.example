# Local Docker Compose operator settings. Copy to .env; never place secrets here.
MARKETPLACEHUB_ALLOWED_HOSTS=localhost;127.0.0.1
MARKETPLACEHUB_SITE_ADDRESS=https://localhost
MARKETPLACEHUB_BOOTSTRAP_TENANT_CODE=ravencia
MARKETPLACEHUB_BOOTSTRAP_TENANT_NAME=Ravencia
MARKETPLACEHUB_BOOTSTRAP_OWNER_EMAIL=owner@example.invalid
MARKETPLACEHUB_BOOTSTRAP_OWNER_NAME=Ravencia Admin

# Secrets are read from deploy/secrets/*.txt and are excluded from Git.
# Bootstrap and all external writes remain disabled in the base compose file.
