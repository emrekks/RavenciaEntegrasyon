<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="NetVips.Native.win-x64" />
    <PackageReference Include="xunit.runner.visualstudio"><PrivateAssets>all</PrivateAssets></PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Marketplace payload fixtures and their goldens for the contract tests (Contracts/); test output only. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The shipped settings of the worker and the api, compared by DispatcherCoreTests (the lane model must match). -->
    <None Include="..\..\src\MarketplaceHub.Worker\appsettings.json" Link="ShippedSettings\worker.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\MarketplaceHub.Api\appsettings.json" Link="ShippedSettings\api.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The flip runbook's work-type CASE, run against PostgreSQL and compared with DispatcherLanes.LaneFor (DispatcherPostgreSqlTests). -->
    <None Include="..\..\docs\RUNBOOK-KUYRUK-DAGITICI.md" Link="ShippedDocs\RUNBOOK-KUYRUK-DAGITICI.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Diagnostic messages on: the run's Catalog:MirrorModelFields position line shows in the test output. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MarketplaceHub.Domain\MarketplaceHub.Domain.csproj" />
    <ProjectReference Include="..\..\src\MarketplaceHub.Application\MarketplaceHub.Application.csproj" />
    <ProjectReference Include="..\..\src\MarketplaceHub.Infrastructure\MarketplaceHub.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MarketplaceHub.Api\MarketplaceHub.Api.csproj" />
    <ProjectReference Include="..\..\src\MarketplaceHub.Worker\MarketplaceHub.Worker.csproj" />
  </ItemGroup>
</Project>
